output/
**/output/
out/
**/out/
logs/
**/logs/
*.log
*.time
*.tmp
*.temp
*.cache

# Generated reports and plot caches
Rplots.pdf
plotly/
.plotly/
*.html.tmp
*_cache.html
*.svg.tmp

# Excel and office temporary files
~$*.xlsx
~$*.xls
~$*.csv
