    "editor.allowVariableFontsInAccessibilityMode": true,
    "editor.codeLensFontFamily": "JuliaMono, Maple Mono NF, JetBrains Mono, Input Mono",
    "editor.fontFamily": "FiraCode Nerd Font, Cascadia Code, JuliaMono, Geist Mono, JetBrainsMono Nerd Font, Fira Code",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.lineHeight": 0,
    "editor.wrapOnEscapedLineFeeds": true,
    "editor.wordWrap": "bounded",
