{
    "editor.guides.bracketPairs": "active",
    "BracketHighlighter.activeInDebugMode": false,
    "prettier.bracketSameLine": true,
    "txtsyntax.enableAutoImport": true,
    "txtsyntax.enableHighlightLine": true,
    "txtsyntax.showHighlightSidebar": true,
    "workbench.tree.indent": 18,
    "material-icon-theme.hidesExplorerArrows": true,
    "workbench.tree.renderIndentGuides": "onHover",
    "github.copilot.nextEditSuggestions.enabled": true,
    "path-intellisense.autoTriggerNextSuggestion": true,
    "editor.inlineSuggest.suppressSuggestions": true,
    "debug.console.acceptSuggestionOnEnter": "on",
    "editor.autoIndent": "advanced",
    "indenticator.inner.showIndentGuide": true,
    "markdown.extension.tableFormatter.normalizeIndentation": true,
    "guides.overrideDefault": true,
    "gitlens.views.scm.grouped.views": {
        "repositories": true,
        "searchAndCompare": true,
        "launchpad": true
    },
    "guides.active.width": 0.25,
    "guides.limit.maximum": -1,
    "guides.stack.style": "dotted",
    "guides.normal.width": 0.25,
    "guides.stack.width": 0.5,
    "editor.fontSize": 14,
    "todo-tree.highlights.useColourScheme": true,
    "vim.highlightedyank.enable": true,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontFamily": "Fira Code, Cascadia Code, MesloLGS NF, Geist Mono, Maple Mono, Hack Nerd Font, Hack Nerd Font",
    "terminal.integrated.fontSize": 12,
    "git.terminalGitEditor": true,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.enableImages": true,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.mouseWheelZoom": true,
    "editor.mouseWheelZoom": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminalAllInOne.terminalTheme": "Atelier Cave",
    "julia.executablePath": "",
    "julia.execution.inlineResultsForCellEvaluation": true,
    "julia.execution.codeInREPL": false,
    "vim.autoSwitchInputMethod.enable": true,
    "vim.camelCaseMotion.enable": true,
    "vim.changeWordIncludesWhitespace": true,
    "vim.easymotion": true,
    "vim.statusBarColorControl": true,
    "vim.enableNeovim": true,
    "vim.sneak": true,
    "vim.smartRelativeLine": true,
    "vim.targets.enable": true,
    "vim.useSystemClipboard": true,
    "powershell.buttons.showPanelMovementButtons": true,
    "powershell.codeFormatting.autoCorrectAliases": true,
    "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": true,
    "editor.scrollbar.horizontalScrollbarSize": 88,
    "editor.scrollbar.verticalScrollbarSize": 5,
    "editor.wordWrapColumn": 256,
    "vim.textwidth": 1,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "julia": true,
        "python": true
    },
    "[julia]": {
        "editor.wordWrap": "off"
    },
    "terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",
    "window.autoDetectColorScheme": true,
    "bookmarks.saveBookmarksInProject": true,
    "bookmarks.useWorkaroundForFormatters": true,
    "terminal.integrated.gpuAcceleration": "off",
    "editor.inlineSuggest.edits.showCollapsed": true,
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.agent.thinkingTool": true,
    "github.copilot.chat.editor.temporalContext.enabled": true,
    "github.copilot.chat.scopeSelection": true,
    "github.copilot.chat.followUps": "always",
    "github.copilot.chat.edits.temporalContext.enabled": true,
    "github.copilot.chat.generateTests.codeLens": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": true,
    "github.copilot.chat.languageContext.inline.typescript.enabled": true,
    "github.copilot.chat.languageContext.typescript.enabled": true,
    "github.copilot.chat.completionContext.typescript.mode": "sidecar",
    "github.copilot.chat.search.keywordSuggestions": true,
    "editor.cursorSmoothCaretAnimation": "explicit",
    "terminal.integrated.allowMnemonics": true,
    "editor.lineNumbers": "relative",
    "search.showLineNumbers": true,
    "files.autoSave": "onFocusChange",
    "commentAnchors.tagHighlights.enabled": false,
    "commentAnchors.tags.sortAlphabetically": true,
    "errorLens.gutterIconsEnabled": true,
