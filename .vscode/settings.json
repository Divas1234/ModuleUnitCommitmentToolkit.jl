    "julia.deleteJuliaCovFiles": false,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "name": "Comments",
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "name": "Doc Comments",
                "scope": [
                    "comment.block.documentation",
                    "comment.line.documentation"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "name": "Class / Type Names",
                "scope": [
                    "entity.name.type",
                    "entity.name.type.class",
                    "storage.type.class"
                ],
                "settings": {
                    "fontStyle": "bold underline"
                }
            },
            {
                "name": "Function Names",
                "scope": [
                    "entity.name.function",
                    "meta.function.identifier"
                ],
                "settings": {
                    "fontStyle": "bold underline"
                }
            },
            {
                "name": "Keywords",
                "scope": [
                    "keyword",
                    "keyword.control",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "fontStyle": ""
                }
            },
            {
                "name": "Variables (built-ins)",
                "scope": [
                    "variable.language",
                    "variable.language.this",
                    "variable.language.super"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "name": "Punctuation / Delimiters",
                "scope": [
                    "punctuation",
                    "punctuation.separator",
                    "punctuation.accessor",
                    "punctuation.definition.parameters",
                    "punctuation.definition.string"
                ],
                "settings": {
                    "fontStyle": ""
                }
            },
            {
                "name": "Numeric & Units",
                "scope": [
                    "constant.numeric",
                    "constant.numeric.decimal",
                    "constant.numeric.hex",
                    "constant.numeric.binary",
                    "keyword.other.unit"
                ],
                "settings": {
                    "fontStyle": ""
                }
            },
            {
                "name": "Invalid / Errors",
                "scope": [
                    "invalid",
                    "invalid.illegal",
                    "invalid.deprecated"
                ],
                "settings": {
                    "fontStyle": ""
                }
            }
        ],
